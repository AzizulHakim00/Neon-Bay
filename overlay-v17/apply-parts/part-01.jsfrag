const oldShoot = `function shoot() {
  if(!state.running||state.paused||state.activeVehicle||state.reloading||state.cinematic)return;
  const weapon=WEAPONS[state.weapon];
  const now=performance.now();if(now-lastShotAt<weapon.cooldown)return;lastShotAt=now;
  if(state.ammo<=0){audio.tone(120,.05,'square',.06);notify('Weapon empty. Press R to reload.',1.5);return;}
  state.ammo--;progression.record('shotsFired');audio.shot();raycaster.setFromCamera(new THREE.Vector2(0,0),camera);visualOverhaul?.emitShot(camera.position.clone(),raycaster.ray.direction.clone(),state.weapon);if(state.weapon==='shotgun'){audio.noise(.16,.3);cameraPitch=clamp(cameraPitch+.035,-.75,.32);}
  playerActor?.playOneShot('Shoot',state.weapon==='shotgun'?.42:.28);
  const targets=[];enemies.filter(e=>e.alive).forEach(e=>e.group.traverse(o=>{if(o.isMesh)targets.push(o);}));
  pedestrians.filter(e=>e.alive).forEach(e=>e.group.traverse(o=>{if(o.isMesh)targets.push(o);}));
  const damaged=new Map();
  for(let pellet=0;pellet<weapon.pellets;pellet++){
    const aim=new THREE.Vector2((random()-.5)*weapon.spread,(random()-.5)*weapon.spread);
    raycaster.setFromCamera(aim,camera);const hit=raycaster.intersectObjects(targets,false)[0];
    if(hit&&hit.distance<(state.weapon==='shotgun'?48:90)){const entity=hit.object.userData.entity;if(entity)damaged.set(entity,(damaged.get(entity)||0)+weapon.damage);}
  }
  damaged.forEach((damage,entity)=>{progression.record('hits');entity.takeDamage(entity.boss?damage*.72:damage);});
  state.weaponData[state.weapon].ammo=state.ammo;
  lastGunshotPosition=getPlayerPosition().clone();lastGunshotAt=worldTime;
  raiseWanted('gunfire',state.wanted||1);
}`;

const newShoot = `function shoot() {
  if(!state.running||state.paused||state.activeVehicle||state.reloading||state.cinematic)return;
  const weapon=WEAPONS[state.weapon];
  const now=performance.now();if(now-lastShotAt<weapon.cooldown)return;lastShotAt=now;
  if(state.ammo<=0){audio.tone(120,.05,'square',.06);notify('Weapon empty. Press R to reload.',1.5);return;}
  state.ammo--;progression.record('shotsFired');audio.shot();raycaster.setFromCamera(new THREE.Vector2(0,0),camera);visualOverhaul?.emitShot(camera.position.clone(),raycaster.ray.direction.clone(),state.weapon);
  const recoil=weapon.recoil*(v17Director?.skillEffect('recoil')||1);cameraPitch=clamp(cameraPitch+recoil,-.75,.32);cameraYaw+=(random()-.5)*recoil*.65;
  if(state.weapon==='shotgun')audio.noise(.16,.3);
  playerActor?.playOneShot('Shoot',state.weapon==='shotgun'?.42:.28);
  const targets=[];enemies.filter(e=>e.alive).forEach(e=>e.group.traverse(o=>{if(o.isMesh)targets.push(o);}));
  pedestrians.filter(e=>e.alive).forEach(e=>e.group.traverse(o=>{if(o.isMesh)targets.push(o);}));
  const damaged=new Map();let shotHit=false,shotHeadshot=false;
  const spread=weapon.spread*(v17Director?.skillEffect('spread')||1)*(v17Director?.weaponEffect(state.weapon,'accuracy')||1);
  for(let pellet=0;pellet<weapon.pellets;pellet++){
    const aim=new THREE.Vector2((random()-.5)*spread,(random()-.5)*spread);
    raycaster.setFromCamera(aim,camera);const hit=raycaster.intersectObjects(targets,false)[0];
    if(hit&&hit.distance<weapon.range){const entity=hit.object.userData.entity;if(entity){const headshot=hit.point.y-entity.group.position.y>1.62;const falloff=1-clamp(hit.distance/weapon.range,0,1)*weapon.falloff;let damage=weapon.damage*falloff*(v17Director?.weaponEffect(state.weapon,'damage')||1);if(headshot)damage*=1.65*(v17Director?.skillEffect('headshot')||1);const entry=damaged.get(entity)||{damage:0,headshot:false};entry.damage+=damage;entry.headshot ||= headshot;damaged.set(entity,entry);shotHit=true;shotHeadshot ||= headshot;}}
  }
  damaged.forEach((entry,entity)=>{progression.record('hits');entity.takeDamage(entity.boss?entry.damage*.72:entry.damage);});
  v17Director?.recordShot({hit:shotHit,headshot:shotHeadshot});if(shotHit)v17Director?.showHit(shotHeadshot);
  state.weaponData[state.weapon].ammo=state.ammo;
  lastGunshotPosition=getPlayerPosition().clone();lastGunshotAt=worldTime;
  raiseWanted('gunfire',state.wanted||1);
}`;
source = replaceOnce(source, oldShoot, newShoot, 'combat overhaul');

source = replaceOnce(source,
  "  setTimeout(()=>{const needed=weapon.mag-state.ammo,take=Math.min(needed,state.reserve);state.ammo+=take;state.reserve-=take;state.weaponData[state.weapon].ammo=state.ammo;state.weaponData[state.weapon].reserve=state.reserve;state.reloading=false;dom.weaponName.textContent=weapon.name;audio.tone(420,.08,'square',.05);},weapon.reload);",
